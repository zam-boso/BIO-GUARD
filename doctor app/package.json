{
  "name": "bioguard-doctor",
  "version": "1.0.0",
  "main": "doctormain.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.bioguard.doctor",
    "productName": "BIOGUARD Doctor",
    "files": [
      "**/*",
      "!**/*.map",
      "!dist/**"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "icon": "icon.ico"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "chart.js": "^4.5.1"
  },
  "license": "MIT"
}
